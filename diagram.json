{
  "version": 1,
  "author": "Air Quality Monitor ESP32",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0 },
    { "type": "wokwi-gas-sensor", "id": "mq2", "top": -110, "left": -180,
      "attrs": { "label": "MQ-2" } },
    { "type": "wokwi-gas-sensor", "id": "mq135", "top": 20, "left": -180,
      "attrs": { "label": "MQ-135" } },
    { "type": "wokwi-led", "id": "led_green",  "top": 150, "left": -170,
      "attrs": { "color": "green" } },
    { "type": "wokwi-led", "id": "led_yellow", "top": 150, "left": -130,
      "attrs": { "color": "yellow" } },
    { "type": "wokwi-led", "id": "led_orange", "top": 150, "left": -90,
      "attrs": { "color": "orange" } },
    { "type": "wokwi-led", "id": "led_red",    "top": 150, "left": -50,
      "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 205, "left": -175,
      "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 205, "left": -135,
      "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r3", "top": 205, "left": -95,
      "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r4", "top": 205, "left": -55,
      "attrs": { "value": "220" } },
    { "type": "wokwi-buzzer", "id": "bz1", "top": -60, "left": 180 },
    { "type": "wokwi-relay-module", "id": "fan_relay", "top": 80, "left": 180 }
  ],
  "connections": [
    [ "mq2:VCC", "esp:5V", "red", [] ],
    [ "mq2:GND", "esp:GND.1", "black", [] ],
    [ "mq2:AOUT", "esp:34", "blue", [] ],
    [ "mq135:VCC", "esp:5V", "red", [] ],
    [ "mq135:GND", "esp:GND.1", "black", [] ],
    [ "mq135:AOUT", "esp:35", "green", [] ],
    [ "esp:26", "r1:1", "green", [] ],  [ "r1:2", "led_green:A",  "green", [] ],
    [ "esp:25", "r2:1", "yellow", [] ], [ "r2:2", "led_yellow:A", "yellow", [] ],
    [ "esp:33", "r3:1", "orange", [] ], [ "r3:2", "led_orange:A", "orange", [] ],
    [ "esp:27", "r4:1", "red", [] ],    [ "r4:2", "led_red:A",    "red", [] ],
    [ "led_green:C",  "esp:GND.1", "black", [] ],
    [ "led_yellow:C", "esp:GND.1", "black", [] ],
    [ "led_orange:C", "esp:GND.1", "black", [] ],
    [ "led_red:C",    "esp:GND.1", "black", [] ],
    [ "bz1:2", "esp:14", "orange", [] ],
    [ "bz1:1", "esp:GND.2", "black", [] ],
    [ "fan_relay:VCC", "esp:5V", "red", [] ],
    [ "fan_relay:GND", "esp:GND.2", "black", [] ],
    [ "fan_relay:IN",  "esp:13", "green", [] ]
  ]
}
